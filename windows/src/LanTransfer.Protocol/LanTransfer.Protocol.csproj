<Project Sdk="Microsoft.NET.Sdk">
  <!-- 协议层：与 Android core/protocol 对应；不依赖平台 API，不做 I/O -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- 只使用 X25519；AES-GCM、SHA-256、HMAC-SHA256 用 .NET 内置实现 -->
    <PackageReference Include="BouncyCastle.Cryptography" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LanTransfer.Protocol.Tests" />
    <InternalsVisibleTo Include="LanTransfer.Testing" />
  </ItemGroup>
</Project>
