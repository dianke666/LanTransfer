<Window x:Class="LanTransfer.App.Dialogs.PairingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LanTransfer.App"
        Title="{x:Static local:UiText.AppName}"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,12,0">
                <Path Data="{StaticResource IconShield}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8"
                      Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="HeadingText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="310" />
                <TextBlock x:Name="SubheadingText" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- 6 位数字验证码高亮卡片 -->
        <Border x:Name="SasCard" Grid.Row="1" Visibility="Collapsed"
                Background="{DynamicResource SurfaceSubtleBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="14" Padding="20,16" Margin="0,0,0,14">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="SasCodeText" FontFamily="{StaticResource MonoFont}"
                           FontSize="34" FontWeight="Bold" HorizontalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="{x:Static local:UiText.LabelPairCodeHint}" FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"
                           Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
        </Border>

        <ProgressBar x:Name="BusyBar" Grid.Row="2" IsIndeterminate="True" Height="4"
                     Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderBrush}"
                     BorderThickness="0" Margin="0,0,0,16" Visibility="Collapsed" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RejectBtn" Content="{x:Static local:UiText.BtnReject}"
                    Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                    Visibility="Collapsed" Click="OnRejectClick" />
            <Button x:Name="CancelBtn" Content="{x:Static local:UiText.BtnCancel}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Visibility="Collapsed" Click="OnCancelClick" />
            <Button x:Name="AcceptBtn" Content="{x:Static local:UiText.BtnAccept}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Visibility="Collapsed" Click="OnAcceptClick" />
        </StackPanel>
    </Grid>
</Window>
