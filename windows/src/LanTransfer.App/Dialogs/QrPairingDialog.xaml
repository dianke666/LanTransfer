<Window x:Class="LanTransfer.App.Dialogs.QrPairingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LanTransfer.App"
        Title="{x:Static local:UiText.BtnQrPair}"
        Width="400"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="{x:Static local:UiText.BtnShowQr}" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="{x:Static local:UiText.LabelQrHint}" FontSize="12.5"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 二维码白底高对比度卡片（NearestNeighbor 缩放保证边缘锐利） -->
        <Border Grid.Row="1" HorizontalAlignment="Center"
                Background="#FFFFFF" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,14">
            <Grid Width="232" Height="232">
                <Image x:Name="QrImage" Width="232" Height="232"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       SnapsToDevicePixels="True" />
                <StackPanel x:Name="NoNetworkPanel" Visibility="Collapsed"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconWarning}" Stroke="{DynamicResource WarningBrush}"
                          StrokeThickness="1.8" Width="32" Height="32" Stretch="Uniform"
                          HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="{x:Static local:UiText.ErrorNoNetworkQr}" FontSize="13.5"
                               Foreground="#334155" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,0,0,18">
            <TextBlock x:Name="AddressesText" FontFamily="{StaticResource MonoFont}" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" />
            <TextBlock Text="{x:Static local:UiText.LabelQrAutoRefresh}" FontSize="11.5"
                       Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"
                       Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>

        <Button Grid.Row="3" Content="{x:Static local:UiText.BtnClose}"
                Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right"
                Click="OnCloseClick" />
    </Grid>
</Window>
