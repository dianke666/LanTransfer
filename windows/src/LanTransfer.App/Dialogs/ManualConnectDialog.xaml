<Window x:Class="LanTransfer.App.Dialogs.ManualConnectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LanTransfer.App"
        Title="{x:Static local:UiText.BtnManualConnect}"
        Width="410"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{x:Static local:UiText.BtnManualConnect}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16" />

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="{x:Static local:UiText.LabelIpAddress}" FontSize="12.5" FontWeight="Medium"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
            <TextBox x:Name="IpBox" Style="{StaticResource ModernTextBoxStyle}" FontFamily="{StaticResource MonoFont}" />
            <TextBlock x:Name="IpErrorText" FontSize="12" Foreground="{DynamicResource DangerBrush}"
                       Margin="2,4,0,0" Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="{x:Static local:UiText.LabelPortOptional}" FontSize="12.5" FontWeight="Medium"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
            <TextBox x:Name="PortBox" Style="{StaticResource ModernTextBoxStyle}" FontFamily="{StaticResource MonoFont}" />
            <TextBlock x:Name="PortErrorText" FontSize="12" Foreground="{DynamicResource DangerBrush}"
                       Margin="2,4,0,0" Visibility="Collapsed" />
        </StackPanel>

        <Border x:Name="ResultBanner" Grid.Row="3" Visibility="Collapsed"
                Background="{DynamicResource DangerSoftBrush}" CornerRadius="10" Padding="12,8" Margin="0,0,0,14">
            <TextBlock x:Name="ResultBannerText" FontSize="12.5" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{x:Static local:UiText.BtnCancel}" Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0" Click="OnCancelClick" />
            <Button x:Name="ConnectBtn" Content="{x:Static local:UiText.BtnConnect}"
                    Style="{StaticResource PrimaryButtonStyle}" IsDefault="True" Click="OnConnectClick" />
        </StackPanel>
    </Grid>
</Window>
