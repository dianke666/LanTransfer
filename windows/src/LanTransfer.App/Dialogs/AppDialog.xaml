<Window x:Class="LanTransfer.App.Dialogs.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LanTransfer.App"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
            <Border x:Name="BadgeBorder" Width="36" Height="36" CornerRadius="10"
                    Background="{DynamicResource AccentSoftBrush}" Margin="0,0,12,0">
                <Path x:Name="BadgeIcon" Data="{StaticResource IconShield}"
                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8"
                      Width="18" Height="18" Stretch="Uniform"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="330" />
        </StackPanel>

        <TextBlock x:Name="BodyText" Grid.Row="1" FontSize="13.5" LineHeight="21"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,22" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="SecondaryButton" Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0" Visibility="Collapsed" Click="OnSecondaryClick" />
            <Button x:Name="CancelButton" Style="{StaticResource GhostButtonStyle}"
                    Margin="0,0,8,0" Visibility="Collapsed" Click="OnCancelClick" />
            <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButtonStyle}"
                    Click="OnPrimaryClick" />
        </StackPanel>
    </Grid>
</Window>
