<UserControl x:Class="LanTransfer.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LanTransfer.App"
             xmlns:conv="clr-namespace:LanTransfer.App.Converters"
             Background="{DynamicResource CanvasBrush}"
             FontFamily="{StaticResource AppFont}">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis" />
        <conv:BoolToVisibilityConverter x:Key="InvBoolVis" Invert="True" />
        <conv:StringNotEmptyToVisibilityConverter x:Key="StrVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶栏：标题、筛选胶囊、搜索与清空 -->
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,12">
                    <TextBlock Text="{x:Static local:UiText.NavHistory}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right" Content="{x:Static local:UiText.BtnClearHistory}"
                            Style="{StaticResource DangerButtonStyle}" Command="{Binding ClearAllCommand}" />
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="3" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{x:Static local:UiText.LabelFilterAll}" Command="{Binding SetFilterCommand}" CommandParameter="all" Padding="14,5">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFilterAll}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{x:Static local:UiText.LabelFilterText}" Command="{Binding SetFilterCommand}" CommandParameter="text" Padding="14,5">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFilterText}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{x:Static local:UiText.LabelFilterFile}" Command="{Binding SetFilterCommand}" CommandParameter="file" Padding="14,5">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFilterFile}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>

                    <TextBox Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{x:Static local:UiText.LabelSearchHistory}" />
                </Grid>
            </Grid>
        </Border>

        <!-- 虚拟化记录列表 -->
        <Grid Grid.Row="1">
            <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="54" Height="54" CornerRadius="16" Background="{DynamicResource SurfaceSubtleBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <Path Data="{StaticResource IconHistory}" Stroke="{DynamicResource TextMutedBrush}"
                          StrokeThickness="1.8" Width="24" Height="24" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{x:Static local:UiText.LabelNoHistory}" FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
            </StackPanel>

            <ListBox ItemsSource="{Binding Items}"
                     Visibility="{Binding IsEmpty, Converter={StaticResource InvBoolVis}}"
                     Background="Transparent" BorderThickness="0" Padding="24,16"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorderStyle}" Padding="16,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- 头部元信息：时间、方向、对方名称、状态 -->
                                <Grid Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border CornerRadius="6" Padding="7,2" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding DirectionText}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                        <TextBlock Text="{Binding PeerName}" FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text=" · " Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding TimeText}" FontSize="12" FontFamily="{StaticResource MonoFont}"
                                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" CornerRadius="999" Padding="9,2"
                                            Background="{DynamicResource SurfaceSubtleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </Grid>

                                <!-- 正文或文件名与完整保存路径（19.8 不省略） -->
                                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding TitleText}" FontSize="13.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SizeText}" FontSize="12" FontFamily="{StaticResource MonoFont}"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"
                                               Visibility="{Binding SizeText, Converter={StaticResource StrVis}}" />
                                    <TextBlock Text="{Binding FullPath}" FontSize="11.5" FontFamily="{StaticResource MonoFont}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Visibility="{Binding FullPath, Converter={StaticResource StrVis}}" />
                                </StackPanel>

                                <!-- 操作按钮行 -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <Button Content="{x:Static local:UiText.BtnCopy}" Style="{StaticResource TonalButtonStyle}" Margin="0,0,8,0"
                                            Visibility="{Binding IsText, Converter={StaticResource BoolVis}}"
                                            Command="{Binding DataContext.CopyTextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="{x:Static local:UiText.BtnOpenFile}" Style="{StaticResource TonalButtonStyle}" Margin="0,0,8,0"
                                            Visibility="{Binding CanOpenFile, Converter={StaticResource BoolVis}}"
                                            Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="{x:Static local:UiText.BtnRevealInFolder}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                                            Visibility="{Binding CanOpenFile, Converter={StaticResource BoolVis}}"
                                            Command="{Binding DataContext.RevealFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="{x:Static local:UiText.BtnCopyPath}" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0"
                                            Visibility="{Binding FullPath, Converter={StaticResource StrVis}}"
                                            Command="{Binding DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="{x:Static local:UiText.BtnDelete}" Style="{StaticResource GhostButtonStyle}"
                                            Foreground="{DynamicResource DangerBrush}"
                                            Visibility="{Binding CanDelete, Converter={StaticResource BoolVis}}"
                                            Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
