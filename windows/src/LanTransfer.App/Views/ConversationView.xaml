<UserControl x:Class="LanTransfer.App.Views.ConversationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LanTransfer.App"
             xmlns:conv="clr-namespace:LanTransfer.App.Converters"
             AllowDrop="True"
             DragEnter="OnDragEnter"
             DragOver="OnDragOver"
             DragLeave="OnDragLeave"
             Drop="OnDrop"
             Background="{DynamicResource CanvasBrush}"
             FontFamily="{StaticResource AppFont}">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis" />
        <conv:BoolToVisibilityConverter x:Key="InvBoolVis" Invert="True" />
        <conv:DeviceTypeToGeometryConverter x:Key="DevIcon" />
        <conv:DeviceTypeToAccentBrushConverter x:Key="DevBrush" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部对端信息栏 -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,14,0">
                    <Path Data="{Binding PeerType, Converter={StaticResource DevIcon}}"
                          Stroke="{Binding PeerType, Converter={StaticResource DevBrush}}"
                          StrokeThickness="1.8" Width="20" Height="20" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PeerName}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <Border CornerRadius="999" Padding="9,2" Margin="10,0,0,0"
                                Background="{DynamicResource SuccessSoftBrush}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ConnectionBadge}" FontSize="11.5" FontWeight="Medium"
                                       Foreground="{DynamicResource SuccessBrush}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="{Binding PeerTypeLabel}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text=" · " FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding PeerIp}" FontSize="12" FontFamily="{StaticResource MonoFont}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text=" · " FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{x:Static local:UiText.LabelEncryptedHint}" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 会话内容区（文件任务卡片 + 文字气泡列表） -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel MaxWidth="860">
                <!-- 空态提示 -->
                <Border Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}"
                        Margin="0,60,0,0" HorizontalAlignment="Center" Padding="24">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="56" Height="56" CornerRadius="16" Background="{DynamicResource AccentSoftBrush}"
                                HorizontalAlignment="Center" Margin="0,0,0,14">
                            <Path Data="{StaticResource IconSend}" Stroke="{DynamicResource AccentBrush}"
                                  StrokeThickness="1.8" Width="24" Height="24" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{x:Static local:UiText.LabelNoMessages}" FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Static local:UiText.LabelDragDropTip}" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- 活跃与近期文件传输任务卡片 -->
                <ItemsControl ItemsSource="{Binding Tasks}" Margin="0,0,0,14"
                              Visibility="{Binding HasTasks, Converter={StaticResource BoolVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding HeaderText}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <Border CornerRadius="999" Padding="8,2" Margin="10,0,0,0"
                                                        Background="{DynamicResource AccentSoftBrush}">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11.5" FontWeight="Medium"
                                                               Foreground="{DynamicResource AccentBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding SpeedEtaText}" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="{x:Static local:UiText.BtnResume}"
                                                    Style="{StaticResource TonalButtonStyle}" Margin="0,0,6,0"
                                                    Visibility="{Binding CanResume, Converter={StaticResource BoolVis}}"
                                                    Command="{Binding DataContext.ResumeTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="{x:Static local:UiText.BtnCancel}"
                                                    Style="{StaticResource DangerButtonStyle}"
                                                    Visibility="{Binding CanCancel, Converter={StaticResource BoolVis}}"
                                                    Command="{Binding DataContext.CancelTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>

                                    <ProgressBar Value="{Binding Percent}" Style="{StaticResource ModernProgressBarStyle}" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding ProgressSummary}" FontSize="11.5" FontFamily="{StaticResource MonoFont}"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10" />

                                    <!-- 逐文件列表 -->
                                    <ItemsControl ItemsSource="{Binding Files}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource SurfaceSubtleBrush}" CornerRadius="10" Padding="10,8" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Path Data="{StaticResource IconFile}" Stroke="{DynamicResource TextSecondaryBrush}"
                                                              StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform"
                                                              VerticalAlignment="Center" Margin="0,0,10,0" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Text="{Binding SizeText}" FontSize="11.5" FontFamily="{StaticResource MonoFont}"
                                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                                                <TextBlock Text=" · " FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" />
                                                                <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                                    Visibility="{Binding CanOpen, Converter={StaticResource BoolVis}}">
                                                            <Button Content="{x:Static local:UiText.BtnOpenFile}" Style="{StaticResource GhostButtonStyle}"
                                                                    Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}" />
                                                            <Button Content="{x:Static local:UiText.BtnRevealInFolder}" Style="{StaticResource GhostButtonStyle}"
                                                                    Command="{Binding DataContext.RevealFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 文字消息列表 -->
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,12">
                                <Border MaxWidth="620" CornerRadius="14" Padding="14,11" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                            <Setter Property="Background" Value="{DynamicResource BubbleIncomingBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                    <Setter Property="Background" Value="{DynamicResource BubbleOutgoingBrush}" />
                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <!-- 只读文本控件：支持选中局部文本按 Ctrl+C 精确映射回原文（需求 13.4） -->
                                        <TextBox Text="{Binding VisibleText, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 TextWrapping="Wrap"
                                                 FontSize="13.5"
                                                 Padding="0"
                                                 Tag="{Binding}"
                                                 Loaded="OnMessageTextBoxLoaded">
                                            <TextBox.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{x:Static local:UiText.BtnCopy}" Command="ApplicationCommands.Copy" />
                                                </ContextMenu>
                                            </TextBox.ContextMenu>
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Foreground" Value="{DynamicResource BubbleIncomingTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource BubbleOutgoingTextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>

                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TimeText}" FontSize="11" Opacity="0.78">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource BubbleOutgoingTextBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text=" · " FontSize="11" Opacity="0.7" Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.88">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource BubbleOutgoingTextBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="14,0,0,0">
                                                <Button Content="{Binding ExpandButtonText}" FontSize="11.5" Padding="7,2" Margin="0,0,4,0"
                                                        Visibility="{Binding IsCollapsible, Converter={StaticResource BoolVis}}"
                                                        Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource BubbleOutgoingTextBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Content="{x:Static local:UiText.BtnRetry}" FontSize="11.5" Padding="7,2" Margin="0,0,4,0"
                                                        Visibility="{Binding ShowRetry, Converter={StaticResource BoolVis}}"
                                                        Command="{Binding DataContext.RetryTextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource DangerButtonStyle}" MinHeight="22" />
                                                <Button Content="{x:Static local:UiText.BtnCopy}" FontSize="11.5" Padding="7,2"
                                                        Command="{Binding DataContext.CopyBubbleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource BubbleOutgoingTextBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- 待发送文件托盘 -->
        <Border Grid.Row="2" Visibility="{Binding HasPendingFiles, Converter={StaticResource BoolVis}}"
                Background="{DynamicResource SurfaceSubtleBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="20,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="{Binding PendingSummary}" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{x:Static local:UiText.BtnClearPending}" Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding ClearPendingFilesCommand}" Margin="0,0,6,0" />
                        <Button Content="{x:Static local:UiText.BtnSendPending}" Style="{StaticResource PrimaryButtonStyle}"
                                IsEnabled="{Binding HasNetwork}" Command="{Binding SendPendingFilesCommand}" />
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" MaxHeight="84" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PendingFiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,8,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="12" MaxWidth="180" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SizeText}" FontSize="11" FontFamily="{StaticResource MonoFont}"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="6,0,6,0" VerticalAlignment="Center" />
                                        <Button Content="×" Style="{StaticResource GhostButtonStyle}" Padding="4,0" FontSize="13"
                                                Command="{Binding DataContext.RemovePendingFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 底部现代输入栏 -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="20,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox x:Name="ComposerBox"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="Wrap"
                         MinHeight="64"
                         MaxHeight="150"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top"
                         PreviewKeyDown="OnComposerKeyDown">
                    <TextBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{x:Static local:UiText.BtnCopy}" Command="ApplicationCommands.Copy" />
                            <MenuItem Header="{x:Static local:UiText.BtnPaste}" Command="{Binding PasteCommand}" />
                        </ContextMenu>
                    </TextBox.ContextMenu>
                </TextBox>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                                IsEnabled="{Binding HasNetwork}" Command="{Binding PickFilesCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconFile}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.6"
                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static local:UiText.BtnSendFiles}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                                Command="{Binding PasteCommand}" Content="{x:Static local:UiText.BtnPaste}" />
                        <Button Style="{StaticResource TonalButtonStyle}"
                                IsEnabled="{Binding HasNetwork}" Command="{Binding SendClipboardCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconClipboard}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6"
                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static local:UiText.BtnSendClipboard}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="{Binding CanSendText}" Command="{Binding SendTextCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSend}" Stroke="{DynamicResource AccentOnBrush}" StrokeThickness="1.7"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static local:UiText.BtnSend}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- 拖放文件高亮蒙层（需求 14.2） -->
        <Border Grid.RowSpan="4" Visibility="{Binding IsDragOver, Converter={StaticResource BoolVis}}"
                Background="{DynamicResource AccentSoftBrush}" Opacity="0.94"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"
                CornerRadius="16" Margin="16" IsHitTestVisible="False">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Path Data="{StaticResource IconFile}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                      Width="44" Height="44" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,12" />
                <TextBlock Text="{x:Static local:UiText.LabelDropHint}" FontSize="17" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
