<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 统一设计系统 · 深色主题（对应 shared/design-tokens.json） -->
    <Color x:Key="CanvasColor">#0B1120</Color>
    <Color x:Key="SidebarColor">#0F172A</Color>
    <Color x:Key="SurfaceColor">#162032</Color>
    <Color x:Key="SurfaceElevatedColor">#1E293B</Color>
    <Color x:Key="SurfaceSubtleColor">#111A2B</Color>
    <Color x:Key="SurfaceHoverColor">#243248</Color>
    <Color x:Key="SurfaceSelectedColor">#1E3A5F</Color>
    <Color x:Key="BorderColor">#263449</Color>
    <Color x:Key="BorderStrongColor">#334155</Color>
    <Color x:Key="TextPrimaryColor">#F1F5F9</Color>
    <Color x:Key="TextSecondaryColor">#94A3B8</Color>
    <Color x:Key="TextMutedColor">#64748B</Color>
    <Color x:Key="AccentColor">#3B82F6</Color>
    <Color x:Key="AccentHoverColor">#60A5FA</Color>
    <Color x:Key="AccentPressedColor">#2563EB</Color>
    <Color x:Key="AccentSoftColor">#172554</Color>
    <Color x:Key="AccentOnColor">#FFFFFF</Color>
    <Color x:Key="TealColor">#38BDF8</Color>
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="SuccessSoftColor">#064E3B</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="WarningSoftColor">#451A03</Color>
    <Color x:Key="DangerColor">#EF4444</Color>
    <Color x:Key="DangerSoftColor">#450A0A</Color>
    <Color x:Key="BubbleOutgoingColor">#2563EB</Color>
    <Color x:Key="BubbleOutgoingTextColor">#FFFFFF</Color>
    <Color x:Key="BubbleIncomingColor">#1E293B</Color>
    <Color x:Key="BubbleIncomingTextColor">#F1F5F9</Color>
    <Color x:Key="ShadowColor">#40000000</Color>

    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="{StaticResource SurfaceSubtleColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="{StaticResource SurfaceSelectedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="AccentOnBrush" Color="{StaticResource AccentOnColor}" />
    <SolidColorBrush x:Key="TealBrush" Color="{StaticResource TealColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
    <SolidColorBrush x:Key="BubbleOutgoingBrush" Color="{StaticResource BubbleOutgoingColor}" />
    <SolidColorBrush x:Key="BubbleOutgoingTextBrush" Color="{StaticResource BubbleOutgoingTextColor}" />
    <SolidColorBrush x:Key="BubbleIncomingBrush" Color="{StaticResource BubbleIncomingColor}" />
    <SolidColorBrush x:Key="BubbleIncomingTextBrush" Color="{StaticResource BubbleIncomingTextColor}" />
</ResourceDictionary>
