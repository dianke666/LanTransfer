<Project Sdk="Microsoft.NET.Sdk">
  <!--
    共享测试库（与 Android core 模块的 testFixtures 对应）：属性测试辅助 Pbt、FsCheck 生成器（Gens）、
    引擎端口的内存实现（InMemoryTransport、FakeClock、内存 Store 等）。本项目不是测试项目，不含测试。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FsCheck" />
    <PackageReference Include="FsCheck.Xunit.v3" />
    <PackageReference Include="xunit.v3.assert" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LanTransfer.Protocol\LanTransfer.Protocol.csproj" />
    <ProjectReference Include="..\..\src\LanTransfer.Domain\LanTransfer.Domain.csproj" />
    <ProjectReference Include="..\..\src\LanTransfer.Engine\LanTransfer.Engine.csproj" />
  </ItemGroup>

  <!--
    唯一一份测试向量 protocol/test-vectors 以链接方式复制到输出目录的 test-vectors/ 下；
    引用本项目的各测试项目也会得到这些文件（CopyToOutputDirectory 项随项目引用传递）。
  -->
  <ItemGroup>
    <None Include="..\..\..\protocol\test-vectors\**\*" LinkBase="test-vectors" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
