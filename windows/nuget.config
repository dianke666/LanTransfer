<?xml version="1.0" encoding="utf-8"?>
<!-- 只使用 nuget.org，不继承本机或用户级包源，保证各机器还原结果一致 -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
